{
  "name": "playwright-ts",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean:allure": "rimraf ./allure-results ./allure-report",
    "test:web:p0": "npx playwright test tests/web/P0.spec.ts",
    "test:web:p1": "npx playwright test tests/web/P1.spec.ts",
    "test:web:p2": "npx playwright test tests/web/P2.spec.ts",
    "test:web": "npm run clean:allure && npm run test:web:p0 && npm run test:web:p1 && npm run test:web:p2",
    "test:apis": "newman run ./tests/apis/API-Automation.postman_collection.json -e ./tests/apis/AE-Env-ES.postman_environment.json -r cli,json,allure --reporter-json-export ./allure-results/postman_result.json --reporter-allure-export ./allure-results",
    "report:allure": "npx allure generate ./allure-results --clean -o ./allure-report && npx allure open ./allure-report",
    "P0": "npx playwright test tests/web/P0.spec.ts",
    "P1": "npx playwright test tests/web/P1.spec.ts",
    "P2": "npx playwright test tests/web/P2.spec.ts",
    "Suites": "npx playwright test tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "npm run format:check && npm run lint:ci && npm run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
